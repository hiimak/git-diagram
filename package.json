{
  "name": "@hiimak/git-diagram",
  "version": "0.2.0",
  "description": "git diagram: see an AI-sized diff as a connected file diagram (JS/TS, Python, Java, Kotlin, Spring, C#, Go) instead of reading it line by line",
  "type": "module",
  "bin": {
    "git-diagram": "git-diagram.mjs"
  },
  "files": [
    "git-diagram.mjs",
    "page.html",
    "lib/",
    "grammars/"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "grammars": "node scripts/grammars.mjs"
  },
  "keywords": [
    "git",
    "diff",
    "diagram",
    "code-review",
    "ai",
    "visualization",
    "pull-request",
    "tree-sitter",
    "java",
    "kotlin",
    "spring",
    "csharp",
    "dotnet",
    "golang",
    "typescript",
    "python"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiimak/git-diagram.git"
  },
  "homepage": "https://github.com/hiimak/git-diagram#readme",
  "bugs": "https://github.com/hiimak/git-diagram/issues",
  "license": "MIT",
  "author": "hiimak",
  "dependencies": {
    "web-tree-sitter": "0.27.1"
  }
}
